<FluentDialogBody>

    <TitleTemplate>
        Change password
    </TitleTemplate>

    <ChildContent>
        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />
            <FluentTextInput @bind-Value="_model.NewPassword" Label="New password" TextInputType="TextInputType.Password" Autofocus />
            <FluentTextInput @bind-Value="_model.ConfirmNewPassword" Label="Confirm password" TextInputType="TextInputType.Password" />
        </EditForm>
    </ChildContent>

    <ActionTemplate>
        <FluentButton OnClick="@(e => Dialog.CancelAsync())">Cancel</FluentButton>
        <FluentButton OnClick="SubmitAsync" Appearance="ButtonAppearance.Primary">Change password</FluentButton>
    </ActionTemplate>

</FluentDialogBody>

@code
{
    private EditContext _editContext;
    private PasswordChangeInput _model;

    public PasswordChangeDialog()
    {
        _model = new PasswordChangeInput();
        _editContext = new EditContext(_model);
    }

    [CascadingParameter]
    public required IDialogInstance Dialog { get; set; }

    private async Task SubmitAsync()
    {
        if (_editContext.Validate())
        {
            await Dialog.CloseAsync(_model.NewPassword);
        }
    }
}
