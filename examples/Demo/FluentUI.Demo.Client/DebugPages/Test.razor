@page "/Debug/Test"
@inject IDialogService dialogService
@layout FluentUI.Demo.Client.Layout.EmptyLayout


<FluentButton OnClick="ShowPasswordChangeDialogAsync">Show Dialog</FluentButton>

<FluentProviders />

@code {
    private async Task ShowPasswordChangeDialogAsync()
    {
        DialogOptions parameters = new()
        {
            Width = "500px",
            Modal = true,
        };

        var result = await dialogService.ShowDialogAsync<PasswordChangeDialog>(parameters);
    }
}
